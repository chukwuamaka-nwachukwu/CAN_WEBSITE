{
    "name": "af-sales-app",
    "private": true,
    "version": "2.0.0",
    "type": "module",
    "overrides": {
        "@grpc/grpc-js": "^1.14.6",
        "uuid": "^11.1.1"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "test": "node --test functions/test/*.test.js",
